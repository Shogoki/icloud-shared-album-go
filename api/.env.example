# Copy to .env next to docker-compose.yml and adjust. .env is gitignored —
# this repository is public, so never commit real domains here.

# Host port the local container publishes to.
HOST_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
# Loopback origins (http://localhost:*, http://127.0.0.1:*) are always allowed
# on top of this, so local development needs no entry here.
# Example: https://example.com,https://dev.example.com
CORS_ALLOWED_ORIGINS=

# The longest a resolved album is reused before it is fetched from iCloud
# again. A ceiling only: an album is re-fetched sooner, five minutes before its
# first signed URL expires (iCloud signs them for twenty minutes).
ALBUM_CACHE_TTL_SECONDS=900
